# ============================================================
# FICHIER D'ENVIRONNEMENT — Pascal Hamm Immobilier
# ============================================================
# 1. Copiez ce fichier : cp .env.example .env
# 2. Remplissez TOUTES les valeurs
# 3. NE JAMAIS committer .env (il est dans .gitignore)
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Pascal Hamm Immobilier"
APP_URL=https://pascal-hamm-immobilier-aix-en-provence.fr
APP_EMAIL=contact@pascal-hamm-immobilier-aix-en-provence.fr
APP_ENV=production
# production | staging | development
APP_DEBUG=false
# true uniquement en developpement local

# Optionnel : décommenter PUBLIC_MAINTENANCE=1 pour que le mode maintenance (fichier flag + admin) bloque le front
# PUBLIC_MAINTENANCE=1

# Connexion admin depuis Cursor / PHP built-in (HTTP) : APP_ENV=development + mot de passe ci-dessous
# (même email que ADMIN_EMAIL dans includes/config.php — compte superuser en base de données). Ne jamais remplir en production.
# DEV_ADMIN_PASSWORD=

APP_PHONE="+33 6 67 19 83 66"
# Adresse d’entête (footer, page contact) — personnalisez si besoin
APP_ADDRESS="Aix-en-Provence et Pays d'Aix (Bouches-du-Rhône, 13)"
APP_SIRET="XXX XXX XXX XXXXX"
# Affichage public (accueil, meta…) si champs vides en base
APP_CITY="Aix-en-Provence"
ADVISOR_NAME="Pascal Hamm"
# RCS/RSAC (mention légale)
ADVISOR_RSAC=441887536
# Sous-titre d’identité (footer, contact)
# APP_ADVISOR_TAGLINE="Expert immobilier indépendant à votre ville. Accompagnement en vente, achat et financement."

# ── Base de donnees MySQL/MariaDB ────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=site_immo
DB_USER=site_immo_user
DB_PASS=motdepassefort
DB_CHARSET=utf8mb4
# Optionnel (hébergeurs mutualisés) :
# DB_SOCKET=/var/lib/mysql/mysql.sock
# Alias compatibles aussi acceptés :
# DB_DATABASE, DB_USERNAME, DB_PASSWORD

# ── Session PHP ───────────────────────────────────────────────
SESSION_NAME=pascalhamm_sess
SESSION_LIFE=28800
# Duree en secondes : 28800 = 8 heures

# ── SMTP (envoi d emails) ─────────────────────────────────────
MAIL_FROM=contact@pascal-hamm-immobilier-aix-en-provence.fr
MAIL_FROM_NAME="Pascal Hamm Immobilier"

SMTP_HOST=mail.pascal-hamm-immobilier-aix-en-provence.fr
SMTP_PORT=465
# 587 = TLS (recommande) | 465 = SSL
SMTP_USER=contact@pascal-hamm-immobilier-aix-en-provence.fr
SMTP_PASS=motdepassesmtp
SMTP_FROM=contact@pascal-hamm-immobilier-aix-en-provence.fr
SMTP_FROM_NAME="Pascal Hamm Immobilier"
SMTP_SECURE=ssl

# ── Notification email ────────────────────────────────────────
NOTIF_EMAIL=votre@email.fr
# Email qui recoit les demandes de contact et estimations

# ── Google My Business API ───────────────────────────────────
GMB_ACCOUNT_ID=
# Format : accounts/XXXXXXXXXX
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REFRESH_TOKEN=

# ── Google Analytics ─────────────────────────────────────────
GA_MEASUREMENT_ID=
# Format : G-XXXXXXXXXX
SEARCH_CONSOLE_VERIFICATION=
# Code meta de verification Google Search Console

# ── OpenAI (generation de contenu) ───────────────────────────
OPENAI_API_KEY=
# Optionnel

# ── Anthropic (Claude) + API LLM guide local ─────────────────
ANTHROPIC_API_KEY=
# POST /api/guide-local/llm.php — obligatoire si APP_ENV != development
GUIDE_LOCAL_LLM_API_KEY=
# Optionnel (entiers) : limites rate + TTL cache secondes
# GUIDE_LOCAL_LLM_RL_API_PER_HOUR=120
# GUIDE_LOCAL_LLM_RL_API_PER_MINUTE=15
# GUIDE_LOCAL_LLM_RL_GEN_PER_HOUR=24
# GUIDE_LOCAL_LLM_RL_GEN_PER_MINUTE=6
# GUIDE_LOCAL_LLM_CACHE_TTL_SEC=2592000

# OpenRouter (agents IA) — priorité au champ Admin > Paramètres > Intégrations & API
OPENROUTER_API_KEY=

